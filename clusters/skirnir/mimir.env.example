########################################
# MÍMIR'S WELL
# Single source of truth for Skirnir
########################################

########################################
# Host Identity
########################################

HOSTNAME=skirnir
DOMAIN=aegirshus
DNS_HOST=dns.${DOMAIN}

########################################
# Locale / Time
########################################

TZ=Europe/Stockholm

########################################
# User IDs (Linux permissions)
########################################

PUID=1001
PGID=1001

########################################
# Root Data Paths
########################################

REPO_DIR=/opt/homelab
DATA_ROOT=/srv
DOCKER_DATA=/srv/docker

########################################
# Shared Storage
########################################

MEDIA_PATH=/mnt/media
# Root mount for torrent downloads (qBittorrent categories use subfolders: movies/tv/anime)
DOWNLOADS_PATH=/mnt/torrentdownloads

########################################
# Application Storage
########################################

PAPERLESS_PATH=/srv/paperless
WAZUH_PATH=/srv/wazuh
PROWLARR_HOST=prowlarr.${DOMAIN}
SONARR_HOST=sonarr.${DOMAIN}
RADARR_HOST=radarr.${DOMAIN}
BAZARR_HOST=bazarr.${DOMAIN}
QBITTORRENT_HOST=qbittorrent.${DOMAIN}
FLARESOLVERR_HOST=flaresolverr.${DOMAIN}

########################################
# Docker Networking
########################################

PROXY_NETWORK=proxy

########################################
# Service Hostnames
########################################

JELLYFIN_HOST=jellyfin.${DOMAIN}
PAPERLESS_HOST=paperless.${DOMAIN}
HOMEASSISTANT_HOST=ha.${DOMAIN}
WAZUH_HOST=wazuh.${DOMAIN}
HOMEPAGE_HOST=home.${DOMAIN}
PORTAINER_HOST=portainer.${DOMAIN}
BOREDGAMERTRACKER_HOST=bg.${DOMAIN}
BOREDGAMERTRACKER_PASSWORD=

# DnD cinematic display — served from the gaming PC, not a container.
# DND_PC is that PC's LAN IP; give it a DHCP reservation in the router.
DND_HOST=dnd.${DOMAIN}
DND_PC=192.168.1.103
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=
PAPERLESS_SECRET_KEY=